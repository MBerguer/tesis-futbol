# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# Tables
GPS_TABLE=gps_samples
PLAYERS_TABLE=players
# Sharp angles table (preferred). Otherwise set CSV path.
RISK_TABLE=sharp_angles
RISK_CSV=/workspaces/tesis-futbol/ml/data/sharp_angles.csv

# Column names (override with your schema)
# Time column in GPS (seconds since midnight)
TS_COLUMN=seconds_since_midnight

# GPS columns
GPS_PLAYER_COL=player_display_name
GPS_SPEED_COL=speed
GPS_ACCEL_COL=instantaneous_acceleration
GPS_PLAYER_ID_COL=player_id

# Players table columns (optional)
PLAYERS_BIRTHDATE_COL=birthdate
PLAYERS_ID_COL=player_id

# Risk/Sharp Angles columns
RISK_PLAYER_COL=player_display_name
RISK_TS_START=start
RISK_TS_END=finish

# Sampling / model
HZ=10
WINDOW_SECONDS=10
TEST_SIZE=0.2
EPOCHS=8
BATCH_SIZE=64
# Matches/events tables
MATCHES_TABLE=matches
EVENTS_TABLE=events

# Matches columns
MATCH_ID_COL=match_id
MATCH_DATE_COL=match_date
MATCH_GPS_TABLE_COL=gps_table_name

# Events columns
EVENT_MATCH_ID_COL=match_id
EVENT_MINUTE_COL=minute
EVENT_TYPE_COL=type
