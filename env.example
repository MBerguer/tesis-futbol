# Configuración de desarrollo - Copiar a .env.local para usar

# Base de datos
DATABASE_URL=postgres://nacional:nacional@localhost:5432/nacional
POSTGRES_USER=nacional
POSTGRES_PASSWORD=nacional
POSTGRES_DB=nacional
POSTGRES_HOSTNAME=localhost
POSTGRES_PORT=5432

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
FRONTEND_PORT=3000

# Jupyter
JUPYTER_PORT=8888
JUPYTER_PASSWORD=password

# Desarrollo
NODE_ENV=development
RUST_LOG=debug







